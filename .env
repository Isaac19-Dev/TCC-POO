# =============================================================
# PARQUEADERO — Variables de entorno
# =============================================================
# Edita este archivo para cambiar cualquier configuracion.
# El script start.bat lee este archivo y lo pasa al backend.
# =============================================================

# Puerto donde corre toda la aplicacion (frontend + API)
SERVER_PORT=8080

# Base de datos MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=parqueadero_java
DB_USER=root
DB_PASS=root

# Credenciales del usuario administrador inicial
APP_USERNAME=admin
APP_PASSWORD=admin123

# Cantidad de espacios del parqueadero
APP_ESPACIOS_TOTAL=20
